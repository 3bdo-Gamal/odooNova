<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="CashFlowDashboardClientTemplate">
        <style>
            .wb-dashboard-wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; height: 100%; width: 100%; display: flex; overflow: hidden; background-color: #f4f6f9; }
            .wb-main-content { flex-grow: 1; overflow-y: auto; padding: 2rem; position: relative; }
            .wb-sidebar { width: 350px; flex-shrink: 0; display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; box-shadow: -4px 0 15px rgba(0,0,0,0.03); z-index: 10; height: 100%; transition: margin-right 0.3s ease;}
            .wb-sidebar-scroll { flex: 1 1 auto; overflow-y: auto; min-height: 0; padding: 1.5rem; }
            .wb-glassy-header { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.8); border-radius: 1.25rem; padding: 1rem 1.5rem; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03); position: relative; z-index: 8 !important; }
            .wb-card { background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.3s ease; position: relative; z-index: 1 !important; overflow: visible !important; }
            .wb-card:hover { transform: translateY(-5px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); z-index: 15 !important;}
            .wb-card.cursor-pointer:hover { border-color: #3b82f6; cursor: pointer; }
            .wb-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }

            .icon-primary { background: #eff6ff; color: #3b82f6; } .icon-success { background: #f0fdf4; color: #22c55e; }
            .icon-info { background: #ecfeff; color: #06b6d4; } .icon-warning { background: #fefce8; color: #eab308; }
            .icon-danger { background: #fef2f2; color: #ef4444; } .icon-dark { background: #f1f5f9; color: #334155; }
            .icon-purple { background: #faf5ff; color: #a855f7; } .icon-teal { background: #f0fdfa; color: #14b8a6; }

            .wb-input { border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: inset 0 1px 2px rgba(0,0,0,0.02); transition: all 0.2s; }
            .wb-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none; }
            .wb-search-dropdown-btn { background-color: transparent; border-color: #ccc !important; width: 40px; margin: -2px -5px -2px 0; border-top-right-radius: 4px !important; border-bottom-right-radius: 4px !important; box-shadow: none; transition: background-color 0.2s ease-in-out; }
            .wb-search-dropdown-btn:hover, .wb-search-dropdown-btn[aria-expanded="true"] { background-color: #eef2f6 !important; }
            .custom-submenu { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px; margin-top: 5px; }
            .chart-hint { font-size: 0.75rem; color: #94a3b8; font-weight: normal; margin-left: 8px; }

            /* New KPI Info Tooltip Design */
            .kpi-info-icon {
                position: relative;
                display: inline-block;
                color: #0ea5e9;
                font-size: 12px;
                font-weight: 800;
                margin-left: 4px;
                cursor: help;
                z-index: 20;
                vertical-align: super;
                line-height: 1;
                transition: color 0.2s ease;
            }
            .kpi-info-icon:hover {
                color: #0284c7;
            }

            .wb-tooltip-text {
                visibility: hidden;
                width: max-content;
                max-width: 250px;
                background-color: #000000;
                color: #ffffff;
                text-align: left;
                border-radius: 6px;
                padding: 10px 14px;
                position: absolute;
                z-index: 9999 !important;
                bottom: calc(100% + 8px);
                left: 50%;
                opacity: 0;
                transition: opacity 0.2s ease-in-out;
                font-size: 0.75rem;
                font-weight: 500;
                text-transform: none;
                line-height: 1.4;
                box-shadow: 0 10px 20px rgba(0,0,0,0.5);
                transform: translateX(-50%);
                pointer-events: none;
            }
            .wb-tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -6px;
                border-width: 6px;
                border-style: solid;
                border-color: #000000 transparent transparent transparent;
            }
            .kpi-info-icon.open-left .wb-tooltip-text {
                right: 0;
                left: auto;
                transform: translateX(-8px);
            }
            .kpi-info-icon:hover .wb-tooltip-text {
                visibility: visible;
                opacity: 1;
            }

            .wb-dashboard-wrapper:has(.wb-search-dropdown-btn[aria-expanded="true"]) .wb-tooltip-text {
                visibility: hidden !important; opacity: 0 !important; pointer-events: none !important;
            }
            .wb-dashboard-wrapper:has(.wb-search-dropdown-btn[aria-expanded="true"]) .wb-card {
                pointer-events: none !important;
            }
            /* End KPI Info Tooltip Design */

            .wb-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(5px); z-index: 1040; display: flex; align-items: center; justify-content: center; }
            .wb-modal-content { background: white; border-radius: 20px; width: 100%; max-width: 650px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3); animation: modalFadeIn 0.3s ease-out; }
            @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

            #print_report_area { background: white; padding: 40px; color: #000; font-family: Arial, sans-serif; }
            .print-header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #3b82f6; padding-bottom: 10px; }
            .print-row { display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding: 15px 0; }
            .print-title { font-size: 16px; font-weight: bold; color: #334155; }
            .print-value { font-size: 18px; font-weight: bold; color: #0f172a; }
        </style>

        <div class="wb-dashboard-wrapper">
            <!-- EXCEL MODAL -->
            <t t-if="state.showExportModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-excel-o text-success me-2"></i> Export Cash Flow Excel</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closeExportModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-2">Group Data By (Rows)</label>
                                <select class="form-select wb-input" t-model="state.export_group">
                                    <option value="journal_id">🏦 Bank/Cash Journal</option>
                                    <option value="partner_id">👥 Partner</option>
                                    <option value="date:month">📅 Month</option>
                                </select>
                            </div>
                            <div class="mb-4 p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark"><i class="fa fa-sitemap text-primary me-2"></i>Detailed Excel</h6>
                                    <small class="text-muted">Includes expandable individual payments under each group.</small>
                                </div>
                                <div class="form-check form-switch fs-4 m-0">
                                    <input class="form-check-input shadow-sm" type="checkbox" t-model="state.detailed_excel"/>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closeExportModal">Cancel</button>
                            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" t-on-click="downloadCustomExcel"><i class="fa fa-download me-2"></i> Download Excel</button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- PDF MODAL -->
            <t t-if="state.showPdfModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-pdf-o text-danger me-2"></i> Print Cash Flow Report</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closePdfModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <p class="text-muted mb-3">Include the following KPIs in the printed report:</p>
                            <div class="list-group shadow-sm">
                                <label class="list-group-item d-flex gap-3 py-3"><input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_kpis" style="font-size: 1.3em;"/><span><strong class="d-block text-dark">Liquidity Totals</strong><small class="text-muted">Total Inbounds, Outbounds, and Net Cash Flow.</small></span></label>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closePdfModal">Cancel</button>
                            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" t-on-click="printCleanPDF"><i class="fa fa-print me-2"></i> Print PDF</button>
                        </div>
                    </div>
                </div>
            </t>

            <div id="print_report_area" style="display: none;">
                <div class="print-header">
                    <h1 style="margin: 0; color: #1e293b;">Cash Flow Summary Report</h1>
                    <p style="color: #64748b; margin-top: 5px;">Generated on: <t t-esc="new Date().toLocaleDateString()"/></p>
                </div>
                <div t-if="state.pdf_kpis" class="print-row"><span class="print-title">Total Cash Inbound (Receipts)</span><span class="print-value" style="color: #059669;"><t t-esc="state.total_cash_in"/> EGP</span></div>
                <div t-if="state.pdf_kpis" class="print-row"><span class="print-title">Total Cash Outbound (Payments)</span><span class="print-value" style="color: #dc2626;"><t t-esc="state.total_cash_out"/> EGP</span></div>
                <div t-if="state.pdf_kpis" class="print-row"><span class="print-title">Net Cash Flow</span><span class="print-value" style="color: #3b82f6;"><t t-esc="state.net_cash_flow"/> EGP</span></div>
                <div class="print-row"><span class="print-title">Total Transactions Count</span><span class="print-value"><t t-esc="state.total_transactions"/></span></div>
            </div>

            <!-- MAIN UI -->
            <div class="wb-main-content">
                <div class="wb-glassy-header d-flex justify-content-between align-items-center mb-4 d-print-none gap-4">
                    <div class="flex-shrink-0">
                        <h3 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;"><i class="fa fa-exchange text-primary me-2"></i>Cash Flow Analytics</h3>
                        <p class="text-muted text-sm mb-0">Monitor bank liquidity, cash receipts, and operational payments.</p>
                    </div>

                    <!-- CUSTOM SEARCH BAR -->
                    <div class="flex-grow-1 d-flex justify-content-center d-print-none mx-4" style="max-width: 600px;">
                        <div class="shadow-sm d-flex align-items-stretch w-100" style="background: #ffffff; border-radius: 9999px; border: 1px solid #e2e8f0; min-height: 38px; padding: 0 10px;">
                            <div class="d-flex align-items-center justify-content-center" style="width: 30px;"><i class="fa fa-search text-muted"></i></div>
                            <div class="d-flex flex-wrap flex-grow-1 align-items-center gap-1 py-1" style="min-height: 36px;">
                                <t t-if="state.active_favorite_name">
                                    <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                        <span class="px-2 py-1 text-white" style="background-color: #ffc107;"><i class="fa fa-star"></i></span>
                                        <span class="px-2 fw-bold text-dark"><t t-esc="state.active_favorite_name"/></span>
                                        <i class="fa fa-times px-2 cursor-pointer" t-on-click="clearFavorite"></i>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="state.search_query"><div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;"><span class="px-2 py-1 bg-primary text-white"><i class="fa fa-search"></i></span><span class="px-2"><t t-esc="state.search_query"/></span><i class="fa fa-times px-2 cursor-pointer" t-on-click="clearSearchQuery"></i></div></t>
                                    <t t-if="state.active_filters.internal_transfers"><div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;"><span class="px-2 py-1" style="background-color: #0d9488; color: white;"><i class="fa fa-filter"></i></span><span class="px-2">Internal Transfers</span><i class="fa fa-times px-2 cursor-pointer" t-on-click="() => this.toggleFilter('internal_transfers')"></i></div></t>
                                    <t t-foreach="state.custom_domain" t-as="cf" t-key="cf_index"><div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;"><span class="px-2 py-1" style="background-color: #0d9488; color: white;"><t t-esc="cf.label"/> <t t-esc="cf.operator"/> <t t-esc="cf.value"/></span><i class="fa fa-times px-2 cursor-pointer" t-on-click="() => this.removeCustomFilter(cf_index)"></i></div></t>
                                    <t t-foreach="state.group_by_list" t-as="gb" t-key="gb"><div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;"><span class="px-2 py-1" style="background-color: #4f46e5; color: white;"><i class="fa fa-bars"></i></span><span class="px-2 text-capitalize"><t t-esc="gb"/></span><i class="fa fa-times px-2 cursor-pointer" t-on-click="() => this.removeGroupBy(gb)"></i></div></t>
                                </t>
                                <input type="text" class="border-0 fw-bold flex-grow-1 px-1" t-on-keyup="onSearchKeyUp" placeholder="Search Memo or Partner..." style="box-shadow: none; background: transparent; min-width: 150px; outline: none; height: 26px;"/>
                            </div>
                            <!-- Dropdown -->
                            <div class="dropdown d-flex align-items-stretch">
                                <button class="btn border-0 d-flex align-items-center justify-content-center wb-search-dropdown-btn bg-transparent" data-bs-toggle="dropdown" data-bs-auto-close="outside"><i class="fa fa-caret-down" style="color: #495057; font-size: 14px;"></i></button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg mt-1 p-0" style="width: 650px; border-radius: 12px; border: 1px solid #ccc; z-index: 9999;">
                                    <div class="row g-0">
                                        <div class="col-4 border-end p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-filter me-2 text-muted"></i>Filters</h6>
                                            <a class="dropdown-item px-2 py-1 rounded" href="#" t-on-click.prevent="() => this.toggleFilter('internal_transfers')"><i t-attf-class="fa fa-check me-2 {{ state.active_filters.internal_transfers ? 'text-dark' : 'opacity-0' }}"/> Show Internal Transfers</a>
                                            <div class="dropdown-divider"></div>
                                            <button class="btn btn-sm text-start w-100 fw-bold text-primary px-2" t-on-click.prevent="toggleCustomFilterMenu">Add Custom Filter <i t-attf-class="fa {{ state.show_custom_filter_menu ? 'fa-caret-down' : 'fa-caret-right' }}"></i></button>
                                            <div t-if="state.show_custom_filter_menu" class="custom-submenu" t-on-click.stop="">
                                                <select class="form-select form-select-sm mb-2" t-model="state.cf_field" t-on-change="() => state.cf_value = ''"><t t-foreach="state.model_fields" t-as="f" t-key="f.name"><option t-att-value="f.name"><t t-esc="f.string"/></option></t></select>
                                                <select class="form-select form-select-sm mb-2" t-model="state.cf_operator"><option value="=">is equal to</option><option value="!=">is not equal to</option><option value="ilike">contains</option><option value=">">greater than</option><option value="&lt;">less than</option></select>
                                                <t t-set="c_field" t-value="this.currentField"/>
                                                <t t-if="c_field.type === 'selection'"><select class="form-select form-select-sm mb-2" t-model="state.cf_value"><option value="">-- Select --</option><t t-foreach="c_field.selection" t-as="sel" t-key="sel[0]"><option t-att-value="sel[0]"><t t-esc="sel[1]"/></option></t></select></t>
                                                <t t-elif="c_field.type === 'boolean'"><select class="form-select form-select-sm mb-2" t-model="state.cf_value"><option value="1">Yes</option><option value="0">No</option></select></t>
                                                <t t-elif="c_field.type === 'date' || c_field.type === 'datetime'"><input type="date" class="form-control form-control-sm mb-2" t-model="state.cf_value"/></t>
                                                <t t-else=""><input type="text" class="form-control form-control-sm mb-2" t-model="state.cf_value" placeholder="Value..."/></t>
                                                <button class="btn btn-sm btn-primary w-100" t-on-click="addCustomFilter">Apply</button>
                                            </div>
                                        </div>
                                        <div class="col-4 border-end p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-bars me-2 text-muted"></i>Group By</h6>
                                            <a class="dropdown-item px-2 py-1 rounded" href="#" t-on-click.prevent="() => this.toggleGroupBy('partner_id')"><i t-attf-class="fa fa-check me-2 {{ state.group_by_list.includes('partner_id') ? 'text-dark' : 'opacity-0' }}"/> Partner</a>
                                            <a class="dropdown-item px-2 py-1 rounded" href="#" t-on-click.prevent="() => this.toggleGroupBy('journal_id')"><i t-attf-class="fa fa-check me-2 {{ state.group_by_list.includes('journal_id') ? 'text-dark' : 'opacity-0' }}"/> Journal</a>
                                            <div class="dropdown-divider"></div>
                                            <button class="btn btn-sm text-start w-100 fw-bold text-primary px-2" t-on-click.prevent="toggleCustomGroupMenu">Add Custom Group <i t-attf-class="fa {{ state.show_custom_group_menu ? 'fa-caret-down' : 'fa-caret-right' }}"></i></button>
                                            <div t-if="state.show_custom_group_menu" class="custom-submenu" t-on-click.stop="">
                                                <select class="form-select form-select-sm mb-2" t-model="state.cg_field"><t t-foreach="state.model_fields" t-as="f" t-key="f.name"><option t-att-value="f.name"><t t-esc="f.string"/></option></t></select>
                                                <button class="btn btn-sm btn-primary w-100" t-on-click="addCustomGroupBy">Apply</button>
                                            </div>
                                        </div>
                                        <div class="col-4 p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-star me-2 text-muted"></i>Favorites</h6>
                                            <div class="px-1 mb-3">
                                                <button class="btn btn-light w-100 text-start py-1 border-0 bg-light" t-on-click.prevent="toggleSaveMenu">Save search <i t-attf-class="fa {{ state.show_save_menu ? 'fa-caret-down' : 'fa-caret-left' }}"></i></button>
                                                <t t-if="state.show_save_menu">
                                                    <div class="mt-2" style="font-size: 13px;" t-on-click.stop="">
                                                        <input type="text" class="form-control form-control-sm border-0 border-bottom rounded-0 shadow-none mb-2 px-1" t-model="state.favorite_name" style="border-color: #666 !important;"/>
                                                        <div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="fav_default" t-model="state.is_default_fav"/><label class="form-check-label text-muted" for="fav_default">Default filter</label></div>
                                                        <button class="btn btn-sm w-100 text-white fw-bold" style="background-color: #714B67;" t-on-click="saveFavoriteUI">Save</button>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="dropdown-divider"></div>
                                            <t t-foreach="state.saved_favorites" t-as="fav" t-key="fav.id">
                                                <div class="dropdown-item px-2 py-1 rounded d-flex justify-content-between align-items-center" style="cursor:pointer;"><span t-on-click="() => this.loadFavorite(fav)" class="flex-grow-1"><i class="fa fa-star text-warning me-2"></i> <t t-esc="fav.name"/></span><i class="fa fa-trash text-muted ms-2" t-on-click.stop="() => this.deleteFavorite(fav.id)"></i></div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-success bg-white hover-bg-light text-nowrap" t-on-click="openExportModal" style="transition: all 0.2s;"><i class="fa fa-file-excel-o me-2"></i> Custom Excel</button>
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-danger bg-white hover-bg-light text-nowrap" t-on-click="openPdfModal" style="transition: all 0.2s;"><i class="fa fa-file-pdf-o me-2"></i> Print PDF</button>
                        <button class="btn btn-dark shadow-md rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #1e293b; border: none;" t-on-click="toggleSidebar" title="Toggle Filters"><i class="fa fa-sliders"></i></button>
                    </div>
                </div>

                <div class="pb-4 pt-2">
                    <!-- MAIN KPI ROW -->
                    <div class="row mb-4">
                        <div class="col-xl-4 col-md-4 mb-3" t-on-click="() => this.openRecords('inbound')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer" style="border-left: 4px solid #10b981;">
                                <div class="wb-icon-box icon-success me-3"><i class="fa fa-arrow-down"></i></div>
                                <div class="flex-grow-1">
                                    <p class="text-muted text-uppercase text-xs fw-bold mb-1 d-flex align-items-center">
                                        Total Cash Inbound
                                        <span class="kpi-info-icon" t-on-click.stop="">
                                            ?
                                            <span class="wb-tooltip-text">Total amount of cash received across all selected bank and cash journals.</span>
                                        </span>
                                    </p>
                                    <h4 class="fw-bold mb-0 text-success"><t t-esc="state.total_cash_in"/> <span class="text-sm text-muted fw-normal">EGP</span></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-4 mb-3" t-on-click="() => this.openRecords('outbound')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer" style="border-left: 4px solid #ef4444;">
                                <div class="wb-icon-box icon-danger me-3"><i class="fa fa-arrow-up"></i></div>
                                <div class="flex-grow-1">
                                    <p class="text-muted text-uppercase text-xs fw-bold mb-1 d-flex align-items-center">
                                        Total Cash Outbound
                                        <span class="kpi-info-icon" t-on-click.stop="">
                                            ?
                                            <span class="wb-tooltip-text">Total amount of cash paid out from all selected bank and cash journals.</span>
                                        </span>
                                    </p>
                                    <h4 class="fw-bold mb-0 text-danger"><t t-esc="state.total_cash_out"/> <span class="text-sm text-muted fw-normal">EGP</span></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-4 mb-3" t-on-click="() => this.openRecords('all')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer" t-attf-style="border-left: 4px solid {{ state.net_cash_flow >= 0 ? '#3b82f6' : '#f59e0b' }};">
                                <div class="wb-icon-box icon-primary me-3"><i class="fa fa-balance-scale"></i></div>
                                <div class="flex-grow-1">
                                    <p class="text-muted text-uppercase text-xs fw-bold mb-1 d-flex align-items-center">
                                        Net Cash Flow
                                        <span class="kpi-info-icon open-left" t-on-click.stop="">
                                            ?
                                            <span class="wb-tooltip-text">Difference between Total Cash Inbound and Total Cash Outbound.</span>
                                        </span>
                                    </p>
                                    <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.net_cash_flow"/> <span class="text-sm text-muted fw-normal">EGP</span></h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NEW ANALYTICS ROW: Ratios -->
                    <div class="row mb-4">
                        <div class="col-xl-6 col-md-6 mb-3">
                            <div class="wb-card p-3 h-100 shadow-sm border-0 bg-white">
                                <div class="d-flex align-items-center">
                                    <div class="wb-icon-box icon-purple me-3"><i class="fa fa-line-chart"></i></div>
                                    <div>
                                        <p class="text-muted text-xs fw-bold mb-0 d-flex align-items-center">
                                            Quality of Income (CFO/Net Income)
                                            <span class="kpi-info-icon" t-on-click.stop="">
                                                ?
                                                <span class="wb-tooltip-text">Ratio of Operating Cash to Net Income. 1.0+ indicates high-quality, liquid earnings.</span>
                                            </span>
                                        </p>
                                        <h4 class="fw-bold mb-0 mt-1"><t t-esc="state.quality_of_income"/></h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-md-6 mb-3">
                            <div class="wb-card p-3 h-100 shadow-sm border-0 bg-white">
                                <div class="d-flex align-items-center">
                                    <div class="wb-icon-box icon-teal me-3"><i class="fa fa-shield"></i></div>
                                    <div>
                                        <p class="text-muted text-xs fw-bold mb-0 d-flex align-items-center">
                                            Debt Coverage Ratio
                                            <span class="kpi-info-icon open-left" t-on-click.stop="">
                                                ?
                                                <span class="wb-tooltip-text">Ability to pay current liabilities with current operating cash flow.</span>
                                            </span>
                                        </p>
                                        <h4 class="fw-bold mb-0 mt-1"><t t-esc="state.coverage_ratio"/>x</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NEW ANALYTICS ROW: Three Pillars Chart -->
                    <div class="row mb-4">
                        <div class="col-lg-12">
                            <div class="wb-card p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="fw-bold text-dark m-0 d-flex align-items-center">
                                        The Three Pillars of Cash Flow
                                        <span class="kpi-info-icon" t-on-click.stop="">
                                            ?
                                            <span class="wb-tooltip-text">Shows cash impact broken into Operating (Customers/Vendors), Investing (Internal Transfers), and Financing.</span>
                                        </span>
                                    </h6>
                                </div>
                                <div style="height: 250px; position: relative;"><canvas t-ref="pillars_chart"></canvas></div>
                            </div>
                        </div>
                    </div>

                    <!-- ORIGINAL CHARTS -->
                    <t t-if="state.group_by_list.length > 0">
                        <div class="row mb-4">
                            <div class="col-lg-12">
                                <div class="wb-card p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h6 class="fw-bold text-dark m-0">Custom Grouped Impact Analysis</h6>
                                    </div>
                                    <div style="height: 330px; position: relative;"><canvas t-ref="dynamic_chart"></canvas></div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div class="row mb-4">
                        <div class="col-lg-8 mb-4">
                            <div class="wb-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-4"><h6 class="fw-bold text-dark m-0">Cash Flow Trend (In vs Out vs Net)</h6></div>
                                <div style="height: 320px; position: relative;"><canvas t-ref="trend_chart"></canvas></div>
                            </div>
                        </div>
                        <div class="col-lg-4 mb-4">
                            <div class="wb-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-4"><h6 class="fw-bold text-dark m-0">Liquidity by Journal</h6></div>
                                <div style="height: 320px; position: relative;"><canvas t-ref="journal_chart"></canvas></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-lg-6 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark m-0 mb-4">Top Sources of Cash In (Customers)</h6>
                                <div style="height: 300px; position: relative;"><canvas t-ref="inbound_chart"></canvas></div>
                            </div>
                        </div>
                        <div class="col-lg-6 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark m-0 mb-4">Top Sinks of Cash Out (Vendors)</h6>
                                <div style="height: 300px; position: relative;"><canvas t-ref="outbound_chart"></canvas></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORIGINAL SIDEBAR -->
            <div class="wb-sidebar d-print-none" t-if="state.showSidebar">
                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center"><i class="fa fa-sliders text-primary me-2 fs-5"></i><h5 class="fw-bold text-dark mb-0">Cash Filters</h5></div>
                    <button class="btn btn-sm btn-light border rounded-circle" t-on-click="toggleSidebar"><i class="fa fa-times"></i></button>
                </div>
                <div class="wb-sidebar-scroll">
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Time Period</label>
                        <select class="form-select wb-input mb-3" t-model="state.period" t-on-change="onChangePeriod">
                            <option value="0" disabled="1">-- Select Duration --</option>
                            <option value="7">📅 Last 7 Days</option>
                            <option value="30">📅 Last 30 Days</option>
                            <option value="90">📅 Last Quarter</option>
                            <option value="180">📅 Last 6 Months</option>
                            <option value="365">📅 Last Year</option>
                        </select>
                        <div class="p-3 bg-light rounded-3 border border-light">
                            <label class="text-xs fw-bold text-dark mb-2"><i class="fa fa-calendar me-1"></i> Custom Range</label>
                            <input type="date" class="form-control wb-input form-control-sm mb-2" t-model="state.date_from" t-on-change="applyDateFilter"/>
                            <input type="date" class="form-control wb-input form-control-sm" t-model="state.date_to" t-on-change="applyDateFilter"/>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25"/>
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-3">Liquidity Dimensions</label>
                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Direction (In/Out)</label>
                            <select class="form-select wb-input" t-model="state.payment_type" t-on-change="onChangeFilter">
                                <option value="all">🔄 All Flows</option>
                                <option value="inbound">📥 Cash Inbound Only</option>
                                <option value="outbound">📤 Cash Outbound Only</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Bank/Cash Journal</label>
                            <select class="form-select wb-input" t-model="state.journal_id" t-on-change="onChangeFilter">
                                <option value="all">🏦 All Bank &amp; Cash Accounts</option>
                                <t t-foreach="state.filter_journals" t-as="journal" t-key="journal.id"><option t-att-value="journal.id.toString()"><t t-esc="journal.name"/></option></t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Partner Entity</label>
                            <select class="form-select wb-input" t-model="state.partner_type" t-on-change="onChangeFilter">
                                <option value="all">👥 Customers &amp; Vendors</option>
                                <option value="customer">👤 Customers</option>
                                <option value="supplier">🏢 Vendors</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>