<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="PosDashboardClientTemplate">
        <div class="o_dashboard_container" style="padding:20px; height:100%; overflow-y:auto; background-color: #f9f9f9;">



<div class="d-flex justify-content-end mb-4">

    <div class="card shadow-sm border-0 p-3"
         style="border-radius:15px; background:#ffffff;">

        <div class="d-flex gap-2 flex-wrap align-items-center">

            <!-- Main Filter -->
            <select class="form-select shadow-sm"
                    t-model="state.filter_type"
                    t-on-change="onChangeFilter"
                    style="width:200px; border-radius: 12px;">

                <option value="today">📅 Today</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
                <option value="custom">⚙ Custom Range</option>
            </select>

            <!-- Custom Date Inputs -->
           <t t-if="state.filter_type === 'custom'">
    <div class="d-flex gap-2 align-items-center">

        <small class="text-muted">From</small>

        <input type="date"
               class="form-control shadow-sm"
               t-on-change="onChangeDateFrom"
               style="width:170px; border-radius: 12px;"/>

        <small class="text-muted">To</small>

        <input type="date"
               class="form-control shadow-sm"
               t-on-change="onChangeDateTo"
               style="width:170px; border-radius: 12px;"/>

    </div>
</t>

        </div>

    </div>

</div>

            <div class="row mb-3">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #1cc88a !important;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">POS Revenue</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.pos_revenue"/> <small>EGP</small></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #36b9cc !important;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">POS Orders Count</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.pos_orders_count"/></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #f6c23e !important;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Discount %</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.discount_pct"/>%</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #e74a3b !important;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Refund Rate</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.pos_refund_rate"/>%</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #4e73df !important; background-color: #f1f4ff;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Cash Ratio %</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.cash_ratio"/>% 💵</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #858796 !important; background-color: #f8f9fc;">
                        <div class="card-body">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Card Ratio %</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800"><t t-esc="state.card_ratio"/>% 💳</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-8 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 bg-white">
                            <h6 class="m-0 font-weight-bold text-success">Revenue per Hour (Peak Times)</h6>
                        </div>
                        <div class="card-body">
                            <div style="height: 300px;">
                                <canvas t-ref="hourly_chart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3 bg-white">
                            <h6 class="m-0 font-weight-bold text-success">Payment Methods</h6>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <div style="height: 250px; width: 100%;">
                                <canvas t-ref="payment_chart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>