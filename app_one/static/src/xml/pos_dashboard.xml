<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="PosDashboardClientTemplate">
        <style>
            .wb-dashboard-wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; height: 100%; width: 100%; display: flex; overflow: hidden; background-color: #f4f6f9; }
            .wb-main-content { flex-grow: 1; overflow-y: auto; padding: 2rem; position: relative; }
            .wb-sidebar { width: 350px; flex-shrink: 0; display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; box-shadow: -4px 0 15px rgba(0,0,0,0.03); z-index: 10; height: 100%; transition: margin-right 0.3s ease;}
            .wb-sidebar-scroll { flex: 1 1 auto; overflow-y: auto; min-height: 0; padding: 1.5rem; }
            .wb-glassy-header { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.8); border-radius: 1.25rem; padding: 1rem 1.5rem; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03); }
            .wb-card { background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.3s ease; }
            .wb-card:hover { transform: translateY(-5px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); }
            .wb-card.cursor-pointer:hover { border-color: #3b82f6; cursor: pointer; }
            .wb-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
            .icon-primary { background: #eff6ff; color: #3b82f6; } .icon-success { background: #f0fdf4; color: #22c55e; }
            .icon-info { background: #ecfeff; color: #06b6d4; } .icon-warning { background: #fefce8; color: #eab308; }
            .icon-danger { background: #fef2f2; color: #ef4444; } .icon-dark { background: #f1f5f9; color: #334155; }
            .icon-purple { background: #faf5ff; color: #a855f7; } .icon-teal { background: #f0fdfa; color: #14b8a6; }
            .wb-input { border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: inset 0 1px 2px rgba(0,0,0,0.02); transition: all 0.2s; }
            .wb-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none; }
            .wb-native-search .o_searchview { background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); padding: 4px 18px; transition: all 0.3s;}
            .wb-native-search .o_searchview:focus-within { background: #ffffff; border-color: #93c5fd; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
            .chart-hint { font-size: 0.75rem; color: #94a3b8; font-weight: normal; margin-left: 8px; }
            .wb-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(5px); z-index: 1040; display: flex; align-items: center; justify-content: center; }
            .wb-modal-content { background: white; border-radius: 20px; width: 100%; max-width: 650px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3); animation: modalFadeIn 0.3s ease-out; }
            @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
            #print_report_area { background: white; padding: 40px; color: #000; font-family: Arial, sans-serif; }
            .print-header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #059669; padding-bottom: 10px; }
            .print-row { display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding: 15px 0; }
            .print-title { font-size: 16px; font-weight: bold; color: #334155; }
            .print-value { font-size: 18px; font-weight: bold; color: #0f172a; }
        </style>

        <div class="wb-dashboard-wrapper">
            <t t-if="state.showExportModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-excel-o text-success me-2"></i> Export POS Excel</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closeExportModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-2">Group Data By (Rows)</label>
                                <select class="form-select wb-input" t-model="state.export_group">
                                    <option value="config_id">🏪 POS Point</option>
                                    <option value="user_id">👔 Cashier</option>
                                    <option value="product_id">📦 Product</option>
                                    <option value="categ_id">📁 Category</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-3">Select Measures (Columns)</label>
                                <div class="row g-3">
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_rev" t-model="state.meas_revenue"/><label class="form-check-label text-dark fw-bold" for="meas_rev">Total Revenue</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_qty" t-model="state.meas_qty"/><label class="form-check-label text-dark fw-bold" for="meas_qty">Quantity Sold</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_discount" t-model="state.meas_discount"/><label class="form-check-label text-dark fw-bold" for="meas_discount">Discounts</label></div></div>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closeExportModal">Cancel</button>
                            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" t-on-click="downloadCustomExcel">
                                <i class="fa fa-download me-2"></i> Download Excel
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="state.showPdfModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-pdf-o text-danger me-2"></i> Print POS Report</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closePdfModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <p class="text-muted mb-3">Select the KPIs you want to include in the printed report:</p>
                            <div class="list-group shadow-sm">
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_revenue" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">POS Revenue</strong><small class="text-muted">Total POS sales value.</small></span>
                                </label>
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_orders" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Orders Count</strong><small class="text-muted">Number of receipts.</small></span>
                                </label>
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_ratios" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Payment Ratios</strong><small class="text-muted">Cash vs Card %.</small></span>
                                </label>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closePdfModal">Cancel</button>
                            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" t-on-click="printCleanPDF"><i class="fa fa-print me-2"></i> Print PDF</button>
                        </div>
                    </div>
                </div>
            </t>

            <div id="print_report_area" style="display: none;">
                <div class="print-header">
                    <h1 style="margin: 0;">POS Performance Report</h1>
                    <p style="color: #64748b; margin-top: 5px;">Generated on: <t t-esc="new Date().toLocaleDateString()"/></p>
                </div>
                <div t-if="state.pdf_revenue" class="print-row"><span class="print-title">Total POS Revenue</span><span class="print-value"><t t-esc="state.pos_revenue"/> EGP</span></div>
                <div t-if="state.pdf_orders" class="print-row"><span class="print-title">POS Orders Count</span><span class="print-value"><t t-esc="state.pos_orders_count"/></span></div>
                <div t-if="state.pdf_ratios" class="print-row"><span class="print-title">Cash Ratio</span><span class="print-value"><t t-esc="state.cash_ratio"/> %</span></div>
                <div t-if="state.pdf_ratios" class="print-row"><span class="print-title">Card Ratio</span><span class="print-value"><t t-esc="state.card_ratio"/> %</span></div>
                <div class="print-row"><span class="print-title">Discount Percentage</span><span class="print-value"><t t-esc="state.discount_pct"/> %</span></div>
                <div class="print-row"><span class="print-title">Refund Rate</span><span class="print-value" style="color: #dc2626;"><t t-esc="state.refund_rate"/> %</span></div>
            </div>

            <div class="wb-main-content">
                <div class="wb-glassy-header d-flex justify-content-between align-items-center mb-4 d-print-none">
                    <div>
                        <h3 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">
                            <i class="fa fa-desktop text-primary me-2"></i>POS Analytics
                        </h3>
                        <p class="text-muted text-sm mb-0">Track retail performance and POS KPIs.</p>
                    </div>
                    <div class="wb-native-search mx-4 flex-grow-1" style="max-width: 450px;">
                        <SearchBar t-if="env.searchModel" />
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-success bg-white hover-bg-light text-nowrap" t-on-click="openExportModal" style="transition: all 0.2s;"><i class="fa fa-file-excel-o me-2"></i> Export Excel</button>
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-danger bg-white hover-bg-light text-nowrap" t-on-click="openPdfModal" style="transition: all 0.2s;"><i class="fa fa-file-pdf-o me-2"></i> Print PDF</button>
                        <button class="btn btn-dark shadow-md rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #1e293b; border: none;" t-on-click="toggleSidebar" title="Toggle Filters"><i class="fa fa-sliders"></i></button>
                    </div>
                </div>

                <div id="pdf_export_area" class="pb-4 pt-2">

                    <div class="row mb-4">
                        <div class="col-xl-4 col-md-6 mb-3" t-on-click="() => this.openRecords('orders')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                                <div class="wb-icon-box icon-primary me-3"><i class="fa fa-money"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">POS Revenue</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.pos_revenue"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6 mb-3" t-on-click="() => this.openRecords('orders')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                                <div class="wb-icon-box icon-info me-3"><i class="fa fa-shopping-cart"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Orders Count</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.pos_orders_count"/></h4></div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6 mb-3">
                            <div class="wb-card p-3 h-100 d-flex align-items-center">
                                <div class="wb-icon-box icon-warning me-3"><i class="fa fa-calculator"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Avg Order Value</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.aov"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-xl-3 col-md-6 mb-3"><div class="wb-card p-3 h-100 d-flex align-items-center"><div class="wb-icon-box icon-success me-3"><i class="fa fa-bank"></i></div><div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Cash Ratio</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.cash_ratio"/>% </h4></div></div></div>
                        <div class="col-xl-3 col-md-6 mb-3"><div class="wb-card p-3 h-100 d-flex align-items-center"><div class="wb-icon-box icon-purple me-3"><i class="fa fa-credit-card"></i></div><div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Card Ratio</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.card_ratio"/>%</h4></div></div></div>
                        <div class="col-xl-3 col-md-6 mb-3"><div class="wb-card p-3 h-100 d-flex align-items-center"><div class="wb-icon-box icon-teal me-3"><i class="fa fa-tags"></i></div><div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Discount Rate</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.discount_pct"/>%</h4></div></div></div>
                        <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openRecords('refunds')"><div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer"><div class="wb-icon-box icon-danger me-3"><i class="fa fa-undo"></i></div><div><p class="text-danger text-uppercase text-xs fw-bold mb-1">POS Refund Rate</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.refund_rate"/>%</h4></div></div></div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-lg-8 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark mb-4">Revenue per Hour <span class="chart-hint">(Peak Sales Time)</span></h6>
                                <div style="height: 350px; position: relative;"><canvas t-ref="hourly_chart"></canvas></div>
                            </div>
                        </div>
                        <div class="col-lg-4 mb-4">
                            <div class="wb-card p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="fw-bold text-dark m-0">Top Products (Qty)</h6>
                                    <select class="form-select form-select-sm w-auto wb-input rounded-pill px-3" t-model="state.top_products" t-on-change="onChangeFilter">
                                        <option value="5">Top 5</option>
                                        <option value="10">Top 10</option>
                                    </select>
                                </div>
                                <div style="height: 350px; position: relative;"><canvas t-ref="product_chart"></canvas></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="wb-sidebar d-print-none" t-if="state.showSidebar">
                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center"><i class="fa fa-sliders text-primary me-2 fs-5"></i><h5 class="fw-bold text-dark mb-0">POS Filters</h5></div>
                    <button class="btn btn-sm btn-light border rounded-circle" t-on-click="toggleSidebar"><i class="fa fa-times"></i></button>
                </div>
                <div class="wb-sidebar-scroll">
                   <div class="mb-4">
    <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Time Period</label>
    <select class="form-select wb-input mb-3" t-model="state.period" t-on-change="onChangePeriod">
        <option value="0" disabled="1">-- Time Period --</option>
        <option value="7">📅 Last Week (7 Days)</option>
        <option value="30">📅 Last Month (30 Days)</option>
        <option value="90">📅 Last 3 Months (90 Days)</option>
        <option value="180">📅 Last 6 Months (180 Days)</option>
        <option value="365">📅 Last Year (36 5 Days)</option>
    </select>

    <div class="p-3 bg-light rounded-3 border border-light">
        <label class="text-xs fw-bold text-dark mb-2"><i class="fa fa-calendar me-1"></i> Custom Range</label>
        <input type="date" class="form-control wb-input form-control-sm mb-2" t-model="state.date_from" t-on-change="applyDateFilter"/>
        <input type="date" class="form-control wb-input form-control-sm" t-model="state.date_to" t-on-change="applyDateFilter"/>
    </div>
</div>
                    <hr class="text-muted opacity-25"/>
                   <div class="mb-4">
    <label class="form-label text-muted fw-bold text-xs text-uppercase mb-3">Core POS Dimensions</label>

    <div class="mb-3">
        <label class="text-xs text-dark fw-bold mb-1">Order Status</label>
        <select class="form-select wb-input" t-model="state.state" t-on-change="onChangeFilter">
            <option value="all">🟢 All Orders</option>
            <option value="paid">✅ Paid (Completed)</option>
            <option value="done">🔒 Posted</option>
            <option value="invoiced">🧾 Invoiced</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="text-xs text-dark fw-bold mb-1">POS Point / Branch</label>
        <select class="form-select wb-input" t-model="state.config_id" t-on-change="onChangeFilter">
            <option value="all">🏪 All Points</option>
            <t t-foreach="state.filter_configs" t-as="config" t-key="config.id"><option t-att-value="config.id"><t t-esc="config.name"/></option></t>
        </select>
    </div>

    <div class="mb-3">
        <label class="text-xs text-dark fw-bold mb-1">Cashier</label>
        <select class="form-select wb-input" t-model="state.user_id" t-on-change="onChangeFilter">
            <option value="all">👤 All Cashiers</option>
            <t t-foreach="state.filter_users" t-as="user" t-key="user.id"><option t-att-value="user.id"><t t-esc="user.name"/></option></t>
        </select>
    </div>

    <div class="mb-3">
        <label class="text-xs text-dark fw-bold mb-1">Product Category</label>
        <select class="form-select wb-input" t-model="state.category_id" t-on-change="onChangeFilter">
            <option value="all">📦 All Categories</option>
            <t t-foreach="state.filter_categories" t-as="cat" t-key="cat.id"><option t-att-value="cat.id"><t t-esc="cat.name"/></option></t>
        </select>
    </div>

    <div class="mb-3">
        <label class="text-xs text-dark fw-bold mb-1">Payment Method</label>
        <select class="form-select wb-input" t-model="state.payment_method_id" t-on-change="onChangeFilter">
            <option value="all">💳 All Methods</option>
            <t t-foreach="state.filter_payment_methods" t-as="pm" t-key="pm.id"><option t-att-value="pm.id"><t t-esc="pm.name"/></option></t>
        </select>
    </div>
</div>
                </div>
            </div>
        </div>
    </t>
</templates>