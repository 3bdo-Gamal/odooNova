<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="InvoicingDashboardClientTemplate">
        <style>
            .wb-dashboard-wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; height: 100%; width: 100%; display: flex; overflow: hidden; background-color: #f4f6f9; }
            .wb-main-content { flex-grow: 1; overflow-y: auto; padding: 2rem; position: relative; }
            .wb-sidebar { width: 350px; flex-shrink: 0; display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; box-shadow: -4px 0 15px rgba(0,0,0,0.03); z-index: 10; height: 100%; transition: margin-right 0.3s ease;}
            .wb-sidebar-scroll { flex: 1 1 auto; overflow-y: auto; min-height: 0; padding: 1.5rem; }
            .wb-glassy-header { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.8); border-radius: 1.25rem; padding: 1rem 1.5rem; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03); }
            .wb-card { background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.3s ease; }
            .wb-card:hover { transform: translateY(-5px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); }
            .wb-card.cursor-pointer:hover { border-color: #3b82f6; cursor: pointer; }
            .wb-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
            .icon-primary { background: #eff6ff; color: #3b82f6; } .icon-success { background: #f0fdf4; color: #22c55e; }
            .icon-info { background: #ecfeff; color: #06b6d4; } .icon-warning { background: #fefce8; color: #eab308; }
            .icon-danger { background: #fef2f2; color: #ef4444; } .icon-dark { background: #f1f5f9; color: #334155; }
            .icon-purple { background: #faf5ff; color: #a855f7; } .icon-teal { background: #f0fdfa; color: #14b8a6; }
            .wb-input { border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: inset 0 1px 2px rgba(0,0,0,0.02); transition: all 0.2s; }
            .wb-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none; }
            .wb-native-search .o_searchview { background: #f8fafc; border-radius: 9999px; border: 1px solid #e2e8f0; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02); padding: 4px 18px; transition: all 0.3s;}
            .wb-native-search .o_searchview:focus-within { background: #ffffff; border-color: #93c5fd; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
            .chart-hint { font-size: 0.75rem; color: #94a3b8; font-weight: normal; margin-left: 8px; }
        </style>

        <div class="wb-dashboard-wrapper">
            <div class="wb-main-content">
                <div class="wb-glassy-header d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">
                            <i class="fa fa-money text-primary me-2"></i>Invoicing &amp; Collections
                        </h3>
                        <p class="text-muted text-sm mb-0">Monitor cash flow, outstanding debts, and collection rates.</p>
                    </div>
                    <div class="wb-native-search mx-4 flex-grow-1" style="max-width: 450px;">
                        <SearchBar t-if="env.searchModel" />
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark shadow-md rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: #1e293b; border: none;" t-on-click="toggleSidebar" title="Toggle Filters"><i class="fa fa-sliders"></i></button>
                    </div>
                </div>

                <div class="pb-4 pt-2">

                    <div class="row mb-4">
                        <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openRecords('all')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                                <div class="wb-icon-box icon-primary me-3"><i class="fa fa-file-text"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Total Invoiced Amount</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.total_invoiced_amount"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <div class="wb-card p-3 h-100 d-flex align-items-center">
                                <div class="wb-icon-box icon-success me-3"><i class="fa fa-check-circle"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Cash Collected</p><h4 class="fw-bold mb-0 text-success"><t t-esc="state.cash_collected"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openRecords('unpaid')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                                <div class="wb-icon-box icon-warning me-3"><i class="fa fa-hourglass-half"></i></div>
                                <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Accounts Receivable (AR)</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.unpaid_amount"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openRecords('overdue')">
                            <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                                <div class="wb-icon-box icon-danger me-3"><i class="fa fa-exclamation-triangle"></i></div>
                                <div><p class="text-danger text-uppercase text-xs fw-bold mb-1">Overdue Amount</p><h4 class="fw-bold mb-0 text-danger"><t t-esc="state.overdue_amount"/> <span class="text-sm text-muted fw-normal">EGP</span></h4></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-xl-2 col-md-4 col-sm-6 mb-3"><div class="wb-card p-3 h-100 text-center">
                            <p class="text-muted text-uppercase text-xs fw-bold mb-1">Paid Ratio</p>
                            <h4 class="fw-bold mb-0 text-success"><t t-esc="state.paid_ratio"/>%</h4>
                        </div></div>
                        <div class="col-xl-2 col-md-4 col-sm-6 mb-3"><div class="wb-card p-3 h-100 text-center">
                            <p class="text-muted text-uppercase text-xs fw-bold mb-1">Unpaid Ratio</p>
                            <h4 class="fw-bold mb-0 text-warning"><t t-esc="state.unpaid_ratio"/>%</h4>
                        </div></div>
                        <div class="col-xl-2 col-md-4 col-sm-6 mb-3"><div class="wb-card p-3 h-100 text-center border-danger">
                            <p class="text-danger text-uppercase text-xs fw-bold mb-1">Overdue Rate</p>
                            <h4 class="fw-bold mb-0 text-danger"><t t-esc="state.overdue_rate"/>%</h4>
                        </div></div>
                        <div class="col-xl-3 col-md-6 mb-3"><div class="wb-card p-3 h-100 d-flex align-items-center">
                            <div class="wb-icon-box icon-purple me-3"><i class="fa fa-clock-o"></i></div>
                            <div><p class="text-muted text-uppercase text-xs fw-bold mb-1" title="Days Sales Outstanding">Avg Collection Time (DSO)</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.dso"/> <span class="text-sm text-muted fw-normal">Days</span></h4></div>
                        </div></div>
                        <div class="col-xl-3 col-md-6 mb-3"><div class="wb-card p-3 h-100 d-flex align-items-center">
                            <div class="wb-icon-box icon-dark me-3"><i class="fa fa-ban"></i></div>
                            <div><p class="text-muted text-uppercase text-xs fw-bold mb-1">Bad Debt %</p><h4 class="fw-bold mb-0 text-dark"><t t-esc="state.bad_debt_pct"/>%</h4></div>
                        </div></div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-lg-8 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark mb-4">Invoiced vs Collected (Cash Flow Trend)</h6>
                                <div style="height: 320px; position: relative;"><canvas t-ref="trend_chart"></canvas></div>
                            </div>
                        </div>
                        <div class="col-lg-4 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark mb-4">Collection Status</h6>
                                <div style="height: 320px; position: relative;"><canvas t-ref="status_chart"></canvas></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-lg-12 mb-4">
                            <div class="wb-card p-4 h-100">
                                <h6 class="fw-bold text-dark mb-4">Top Customers by Unpaid Amount (Debt)</h6>
                                <div style="height: 300px; position: relative;"><canvas t-ref="customer_chart"></canvas></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="wb-sidebar" t-if="state.showSidebar">
                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center"><i class="fa fa-sliders text-primary me-2 fs-5"></i><h5 class="fw-bold text-dark mb-0">Invoicing Filters</h5></div>
                    <button class="btn btn-sm btn-light border rounded-circle" t-on-click="toggleSidebar"><i class="fa fa-times"></i></button>
                </div>
                <div class="wb-sidebar-scroll">

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Time Period</label>
                        <select class="form-select wb-input mb-3" t-model="state.period" t-on-change="onChangePeriod">
                            <option value="0" disabled="1">-- Select Duration --</option>
                            <option value="7">📅 Last 7 Days</option>
                            <option value="30">📅 Last 30 Days</option>
                            <option value="90">📅 Last Quarter</option>
                            <option value="180">📅 Last 6 Months</option>
                            <option value="365">📅 Last Year</option>
                        </select>
                        <div class="p-3 bg-light rounded-3 border border-light">
                            <label class="text-xs fw-bold text-dark mb-2"><i class="fa fa-calendar me-1"></i> Custom Range</label>
                            <input type="date" class="form-control wb-input form-control-sm mb-2" t-model="state.date_from" t-on-change="applyDateFilter"/>
                            <input type="date" class="form-control wb-input form-control-sm" t-model="state.date_to" t-on-change="applyDateFilter"/>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25"/>
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-3">Finance Dimensions</label>

                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Payment Status</label>
                            <select class="form-select wb-input" t-model="state.payment_state" t-on-change="onChangeFilter">
                                <option value="all">🟢 All States</option>
                                <option value="paid">✅ Fully Paid</option>
                                <option value="partial">⏳ Partially Paid</option>
                                <option value="not_paid">❌ Not Paid</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Sales Journal</label>
                            <select class="form-select wb-input" t-model="state.journal_id" t-on-change="onChangeFilter">
                                <option value="all">📓 All Sales Journals</option>
                                <t t-foreach="state.filter_journals" t-as="journal" t-key="journal.id"><option t-att-value="journal.id"><t t-esc="journal.name"/></option></t>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="text-xs text-dark fw-bold mb-1">Salesperson</label>
                            <select class="form-select wb-input" t-model="state.user_id" t-on-change="onChangeFilter">
                                <option value="all">👤 All Staff</option>
                                <t t-foreach="state.filter_users" t-as="user" t-key="user.id"><option t-att-value="user.id"><t t-esc="user.name"/></option></t>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>