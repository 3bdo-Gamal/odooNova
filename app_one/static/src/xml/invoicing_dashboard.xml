<t t-name="InvoicingDashboardTemplate">
    <div class="o_dashboard_container" style="padding:20px; height:100%; overflow-y:auto; background-color: #f9f9f9;">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
            <h2 class="text-primary fw-bold">🧾 Invoicing &amp; Collections Analytics</h2>
            <select class="form-select shadow-sm" t-model="state.period" t-on-change="onChangePeriod" style="width:180px; border-radius: 10px; border: 2px solid #4e73df;">
                <option value="7">📅 Last 7 Days</option>
                <option value="30">📅 Last 30 Days</option>
                <option value="90">📅 Last Quarter</option>
                <option value="365">📅 Last Year (Full)</option> </select>
        </div>

        <div class="row mb-3">
            <div class="col-md-3"><div class="card shadow-sm border-0 mb-3" style="border-left: 5px solid #4e73df !important;"><div class="card-body"><div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Invoiced</div><div class="h5 mb-0 font-weight-bold text-gray-800"><t t-esc="state.total_invoiced"/></div></div></div></div>
            <div class="col-md-3"><div class="card shadow-sm border-0 mb-3" style="border-left: 5px solid #1cc88a !important;"><div class="card-body"><div class="text-xs font-weight-bold text-success text-uppercase mb-1">Cash Collected</div><div class="h5 mb-0 font-weight-bold text-gray-800"><t t-esc="state.cash_collected"/></div></div></div></div>
            <div class="col-md-3"><div class="card shadow-sm border-0 mb-3" style="border-left: 5px solid #e74a3b !important;"><div class="card-body"><div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Overdue Amount</div><div class="h5 mb-0 font-weight-bold text-gray-800"><t t-esc="state.overdue_amount"/></div></div></div></div>
            <div class="col-md-3"><div class="card shadow-sm border-0 mb-3" style="border-left: 5px solid #6f42c1 !important;"><div class="card-body"><div class="text-xs font-weight-bold text-uppercase mb-1" style="color:#6f42c1">Avg Collection (DSO)</div><div class="h5 mb-0 font-weight-bold text-gray-800"><t t-esc="state.dso"/> Days</div></div></div></div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card shadow mb-4 h-100">
                    <div class="card-header py-3 bg-white"><h6 class="m-0 font-weight-bold text-primary">Payment Status</h6></div>
                    <div class="card-body"><div style="height: 250px;"><canvas t-ref="ratio_chart"></canvas></div></div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow mb-4 h-100">
                    <div class="card-header py-3 bg-white"><h6 class="m-0 font-weight-bold text-primary">Collection Trend (Daily)</h6></div>
                    <div class="card-body"><div style="height: 250px;"><canvas t-ref="trend_chart"></canvas></div></div>
                </div>
            </div>
        </div>
    </div>
</t>