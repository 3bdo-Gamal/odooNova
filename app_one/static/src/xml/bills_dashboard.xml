<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="purchase_bills_dashboard_template" owl="1">
        <style>
            /* ── Layout ── */
            .wb-dashboard-wrapper {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                height: 100%; width: 100%; display: flex; overflow: hidden; background-color: #f4f6f9;
            }
            .wb-main-content { flex-grow: 1; overflow-y: auto; padding: 2rem; position: relative; }

            /* ── Sidebar ── */
            .wb-sidebar { width: 350px; flex-shrink: 0; display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; box-shadow: -4px 0 15px rgba(0,0,0,0.03); z-index: 10; height: 100%; transition: margin-right 0.3s ease; }
            .wb-sidebar-scroll { flex: 1 1 auto; overflow-y: auto; min-height: 0; padding: 1.5rem; }

            /* ── Header (Matched to Sales Dashboard Design) ── */
            .wb-glassy-header {
                position: relative; z-index: 10;
                background: rgba(255,255,255,0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,0.8); border-radius: 1.25rem;
                padding: 1rem 1.5rem; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);
            }

            /* ── Cards ── */
            .wb-card { background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.3s ease; }
            .wb-card:hover { transform: translateY(-5px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); }
            .wb-card.cursor-pointer:hover { border-color: #3b82f6; cursor: pointer; }

            /* ── Icon Boxes ── */
            .wb-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
            .icon-primary { background: #eff6ff; color: #3b82f6; }
            .icon-success { background: #f0fdf4; color: #22c55e; }
            .icon-info    { background: #ecfeff; color: #06b6d4; }
            .icon-warning { background: #fefce8; color: #eab308; }
            .icon-danger  { background: #fef2f2; color: #ef4444; }
            .icon-dark    { background: #f1f5f9; color: #334155; }
            .icon-purple  { background: #faf5ff; color: #a855f7; }

            /* ── Inputs ── */
            .wb-input { border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: inset 0 1px 2px rgba(0,0,0,0.02); transition: all 0.2s; padding: 8px; }
            .wb-input:focus { border-color: #3b82f6; outline: none; }

            /* ── Native Search Bar Customization to look like Sales Pill ── */
            .wb-native-search .o_searchview { background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; }
            .wb-native-search .o_searchview_input_container { padding: 4px 8px; }

            /* ── Chart hint ── */
            .chart-hint { font-size: 0.75rem; color: #94a3b8; font-weight: normal; margin-left: 8px; }

            /* ── Modal ── */
            .wb-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15,23,42,0.6); backdrop-filter: blur(5px); z-index: 1040; display: flex; align-items: center; justify-content: center; }
            .wb-modal-content { background: white; border-radius: 20px; width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3); animation: modalFadeIn 0.3s ease-out; }
            @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

            /* ── Info Icon Tooltip ── */
            .wb-info-wrapper { position: relative; display: inline-flex; align-items: center; }
            .wb-info-icon {
                width: 18px; height: 18px; border-radius: 50%;
                background: #e2e8f0; color: #64748b;
                font-size: 11px; font-weight: 700; font-style: normal;
                display: inline-flex; align-items: center; justify-content: center;
                cursor: default; flex-shrink: 0;
                transition: background 0.2s, color 0.2s;
            }
            .wb-info-icon:hover { background: #3b82f6; color: #fff; }
            .wb-info-tooltip {
                display: none; position: absolute;
                top: calc(100% + 8px); right: 0;
                background: #1e293b; color: #f1f5f9;
                font-size: 12px; line-height: 1.5; font-weight: 400;
                padding: 8px 12px; border-radius: 8px;
                width: 220px; z-index: 999;
                box-shadow: 0 4px 16px rgba(0,0,0,0.18);
                pointer-events: none;
            }
            .wb-info-tooltip::before {
                content: ''; position: absolute; bottom: 100%; right: 6px;
                border: 6px solid transparent; border-bottom-color: #1e293b;
            }
            .wb-info-wrapper:hover .wb-info-tooltip { display: block; }

            /* ── Print area ── */
            #print_report_area { background: white; padding: 40px; color: #000; font-family: Arial, sans-serif; }
        </style>

        <div class="wb-dashboard-wrapper">

          <t t-if="state.showExportModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-excel-o text-success me-2"></i> Export Excel Analytics</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closeExportModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-2">Group Data By (Rows)</label>
                                <select class="form-select wb-input" t-model="state.export_group">
                                    <option value="partner_id">🏢 Vendor</option>
                                    <option value="product_id">📦 Product</option>
                                    <option value="categ_id">📁 Product Category</option>
                                    <option value="invoice_user_id">👔 Purchase Rep</option>
                                    <option value="date:month">📅 Month</option>
                                </select>
                            </div>
                            <div class="mb-4 p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark"><i class="fa fa-sitemap text-primary me-2"></i>Detailed Excel</h6>
                                    <small class="text-muted">Includes expandable/collapsible bill lines under each group.</small>
                                </div>
                                <div class="form-check form-switch fs-4 m-0">
                                    <input class="form-check-input shadow-sm" type="checkbox" t-model="state.detailed_excel"/>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-3">Select Measures (Columns)</label>
                                <div class="row g-3">
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_amt" t-model="state.meas_amount"/><label class="form-check-label text-dark fw-bold" for="meas_amt">Total Billed Amount</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_qty" t-model="state.meas_qty"/><label class="form-check-label text-dark fw-bold" for="meas_qty">Quantity Billed</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_p_var" t-model="state.meas_price_var"/><label class="form-check-label text-dark fw-bold" for="meas_p_var">Price Variance</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_q_var" t-model="state.meas_qty_var"/><label class="form-check-label text-dark fw-bold" for="meas_q_var">Quantity Variance</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_bills" t-model="state.meas_bills"/><label class="form-check-label text-dark fw-bold" for="meas_bills">Bills Count</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="meas_abv" t-model="state.meas_abv"/><label class="form-check-label text-dark fw-bold" for="meas_abv">Avg Bill Value</label></div></div>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closeExportModal">Cancel</button>
                            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" t-on-click="downloadExcel">
                                <i class="fa fa-download me-2"></i> Download Excel
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <div id="print_report_area" style="display:none;">
                <div style="border-bottom: 3px solid #3b82f6; padding-bottom: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end;">
                    <div>
                        <h1 style="margin:0; color:#0f172a; font-size:28px; font-weight:bold;">Purchase Bills Analytics</h1>
                        <p style="margin:8px 0 0 0; color:#64748b; font-size:14px;">Comprehensive Vendor Liabilities &amp; Performance Report</p>
                    </div>
                    <div style="text-align:right;">
                        <p style="margin:0; color:#0f172a; font-weight:bold; font-size:14px;">Report Date</p>
                        <p style="margin:4px 0 0 0; color:#64748b; font-size:14px;"><t t-esc="new Date().toLocaleDateString()"/></p>
                    </div>
                </div>
                <h3 style="color:#0f172a; font-size:18px; margin-bottom:15px; border-left:4px solid #3b82f6; padding-left:10px;">Executive Summary (KPIs)</h3>
                <table style="width:100%; border-collapse:collapse; margin-bottom:40px; font-size:14px;">
                    <thead>
                        <tr style="background-color:#f1f5f9;">
                            <th style="padding:12px 15px; text-align:left; border:1px solid #cbd5e1; color:#334155; font-weight:bold; width:60%;">Metric</th>
                            <th style="padding:12px 15px; text-align:right; border:1px solid #cbd5e1; color:#334155; font-weight:bold; width:40%;">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td style="padding:12px 15px; border:1px solid #cbd5e1;">Total Bills Count</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold;"><t t-esc="state.kpi_data.cards.total_bills_count || 0"/></td></tr>
                        <tr style="background:#f8fafc;"><td style="padding:12px 15px; border:1px solid #cbd5e1;">Total Billed Amount</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:#10b981;"><t t-esc="state.kpi_data.cards.total_bills_amount || '$0'"/></td></tr>
                        <tr><td style="padding:12px 15px; border:1px solid #cbd5e1;">Upcoming Payables</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:#ef4444;"><t t-esc="state.kpi_data.cards.upcoming_payables"/></td></tr>
                        <tr style="background:#f8fafc;"><td style="padding:12px 15px; border:1px solid #cbd5e1;">Average DPO</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:#3b82f6;"><t t-esc="state.kpi_data.cards.avg_dpo"/> Days</td></tr>
                        <tr><td style="padding:12px 15px; border:1px solid #cbd5e1;">Late Bills Ratio</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:#f59e0b;"><t t-esc="state.kpi_data.cards.late_bills_ratio"/>%</td></tr>
                        <tr style="background:#f8fafc;"><td style="padding:12px 15px; border:1px solid #cbd5e1;">Maverick Spend (No PO)</td><td style="padding:12px 15px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:#a855f7;"><t t-esc="state.kpi_data.cards.wo_po_ratio"/>%</td></tr>
                    </tbody>
                </table>
                <div style="margin-top:50px; text-align:center; color:#94a3b8; font-size:12px; border-top:1px solid #e2e8f0; padding-top:20px;">
                    <p style="margin:0;">* Computer-generated from Odoo Dashboard System.</p>
                </div>
            </div>

            <div class="wb-main-content">

                <div class="wb-glassy-header d-flex justify-content-between align-items-center mb-4 d-print-none gap-4">

                    <div class="flex-shrink-0">
                        <h3 class="fw-bolder mb-1 text-dark" style="letter-spacing:-0.5px;">
                            <i class="fa fa-shopping-cart text-primary me-2"></i>Purchase Bills Analytics
                        </h3>
                        <p class="text-muted text-sm mb-0">Monitor vendor bills, spending trends, and accuracy.</p>
                    </div>
                    <div class="flex-grow-1 d-flex justify-content-center d-print-none mx-4 wb-native-search" style="max-width: 600px;">
    <div class="shadow-sm d-flex align-items-stretch w-100" style="background: #ffffff; border-radius: 9999px; border: 1px solid #e2e8f0; min-height: 38px; padding: 0 10px;">
        <div class="flex-grow-1 d-flex align-items-center w-100 border-0">
            <SearchBar t-if="env.searchModel" />
        </div>
    </div>
</div>

                    <div class="d-flex gap-2 flex-shrink-0">
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-success bg-white text-nowrap" t-on-click="openExportModal" style="transition:all 0.2s;">
                            <i class="fa fa-file-excel-o me-2"></i> Export Excel
                        </button>
                        <button class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-danger bg-white text-nowrap" t-on-click="printPDF" style="transition:all 0.2s;">
                            <i class="fa fa-file-pdf-o me-2"></i> Print PDF
                        </button>
                        <button class="btn btn-dark shadow-md rounded-circle d-flex align-items-center justify-content-center" style="width:42px; height:42px; background:#1e293b; border:none;" t-on-click="toggleSidebar">
                            <i class="fa fa-sliders"></i>
                        </button>
                    </div>
                </div>

                <div class="row mb-4">

                    <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openAction('all')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-success me-3"><i class="fa fa-usd"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Total Bills Amount  </p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.total_bills_amount || '$0'"/></h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Total monetary value of all vendor bills matching the active filters and reporting criteria. Click to access the detailed bill records.</div>
                                </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openAction('all_count')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-dark me-3"><i class="fa fa-files-o"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Total Vendor Bills</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.total_bills_count || 0"/></h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Total number of vendor bills included within the current reporting scope. Click to open the related bill records.
                                </div>
                                </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openAction('upcoming')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-primary me-3"><i class="fa fa-money"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Outstanding Payables</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.upcoming_payables"/></h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Total unpaid payable amount for posted vendor bills with current or future due dates. Click to review outstanding liabilities.
                                </div>
                                </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3" t-on-click="() => this.openAction('dpo')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-primary me-3"><i class="fa fa-calendar-check-o"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Avg DPO</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.avg_dpo"/> <small class="fs-6 text-muted">Days</small></h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Average Days Payable Outstanding (DPO), representing the average time taken between bill issuance and payment due date.
                                </div>
                                </div>
                        </div>
                    </div>

                </div>

                <div class="row mb-4">

                    <div class="col-xl-4 col-md-6 mb-3" t-on-click="() => this.openAction('late_bills')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-warning me-3"><i class="fa fa-exclamation-triangle"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Overdue Bills Ratio</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.late_bills_ratio"/>%</h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Percentage of unpaid vendor bills that have exceeded their due dates. Click to analyze overdue liabilities.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-md-6 mb-3" t-on-click="() => this.openAction('wo_po')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-info me-3"><i class="fa fa-file-text-o"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Maverick Spend Ratio</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.wo_po_ratio"/>%</h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Percentage of vendor bills created without linked Purchase Orders, indicating unmanaged or off-process procurement spending.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-md-6 mb-3" t-on-click="() => this.openAction('wo_po')">
                        <div class="wb-card p-3 h-100 d-flex align-items-center cursor-pointer">
                            <div class="wb-icon-box icon-purple me-3"><i class="fa fa-link"></i></div>
                            <div class="flex-grow-1">
                                <p class="text-muted text-uppercase text-xs fw-bold mb-1">Bills Without Purchase Orders</p>
                                <h4 class="fw-bold mb-0 text-dark"><t t-esc="state.kpi_data.cards.wo_po_count || 0"/></h4>
                            </div>
                            <div class="wb-info-wrapper ms-2">
                                <span class="wb-info-icon">i</span>
                                <div class="wb-info-tooltip">Total number of vendor bills not associated with any Purchase Order. Click to review non-compliant procurement transactions.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                    <h5 class="fw-bolder m-0 text-dark">
                        <i class="fa fa-shield me-2 text-secondary"></i>Invoice Compliance &amp; Procurement Control
                    </h5>
                </div>

                <div class="row g-4 mb-4">

                    <div class="col-lg-7">
                        <div class="wb-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-balance-scale text-danger me-2"></i>Purchase Price Variance Analysis

                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted fw-bold text-xs">
                                        <span class="text-danger">■</span> Overbilled <span class="text-success ms-2">■</span> Underbilled
                                    </small>
                                    <div class="wb-info-wrapper ms-1">
                                        <span class="wb-info-icon">i</span>
                                        <div class="wb-info-tooltip">Compares billed unit prices against approved Purchase Order prices to identify overbilling or underbilling variances across vendors and products. (Click to drill down)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div style="height:280px; position:relative; cursor:pointer;" t-on-click="() => this.openAction('price_var')">
                                <canvas t-ref="chart_price_var"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="wb-card h-100 overflow-hidden d-flex flex-column p-0">
                            <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-cubes text-info me-2"></i> Billed Quantity Variance
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-white border shadow-sm rounded-pill fw-bold text-xs px-3" t-on-click="() => this.openAction('qty_variance_pivot')">
                                        <i class="fa fa-table me-1"></i> Pivot View
                                    </button>
                                    <div class="wb-info-wrapper">
                                        <span class="wb-info-icon">i</span>
                                        <div class="wb-info-tooltip">Displays discrepancies between ordered quantities and billed quantities for purchased products. Positive variances indicate excess billing quantities.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive flex-grow-1" style="max-height:280px; cursor:pointer;" t-on-click="() => this.openAction('qty_variance_pivot')">
                                <table class="table table-hover table-borderless align-middle mb-0">
                                    <thead class="table-light position-sticky top-0" style="z-index:1;">
                                        <tr>
                                            <th class="px-4 py-3 text-uppercase text-muted text-xs fw-bold">Product</th>
                                            <th class="px-4 py-3 text-uppercase text-muted text-xs fw-bold text-end">Variance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.kpi_data.tables?.qty_variance_pivot || []" t-as="row" t-key="row.product">
                                            <td class="px-4 py-2 fw-bold text-dark" style="font-size:0.85rem;"><t t-esc="row.product"/></td>
                                            <td class="px-4 py-2 fw-bolder text-end">
                                                <span t-attf-class="badge rounded-pill px-3 py-2 {{ row.qty_variance > 0 ? 'bg-danger' : (row.qty_variance &lt; 0 ? 'bg-success' : 'bg-secondary') }}">
                                                    <t t-esc="row.qty_variance"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row g-4 mb-4">

                    <div class="col-lg-8">
                        <div class="wb-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-line-chart text-primary me-2"></i>Procurement Spend Trend
                                    <span class="chart-hint">(Click to drill down)</span>
                                </h6>
                                <div class="wb-info-wrapper">
                                    <span class="wb-info-icon">i</span>
                                    <div class="wb-info-tooltip">Tracks monthly procurement spending trends based on vendor bills, helping identify seasonal patterns, spending spikes, and purchasing behavior changes.
                                    </div>
                                </div>
                            </div>
                            <div style="height:280px; position:relative; cursor:pointer;" t-on-click="() => this.openAction('trend')">
                                <canvas t-ref="chart_trend"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="wb-card p-4 h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-pie-chart text-warning me-2"></i>Payment Status Distribution
                                    <span class="chart-hint">(Click segment to view records)</span>
                                </h6>
                                <div class="wb-info-wrapper">
                                    <span class="wb-info-icon">i</span>
                                    <div class="wb-info-tooltip">Distribution of vendor bill amounts by payment status, providing visibility into settled versus outstanding financial obligations.
                                    </div>
                                </div>
                            </div>
                            <div style="height:280px; position:relative; cursor:pointer;" t-on-click="() => this.openAction('status')">
                                <canvas t-ref="chart_status"></canvas>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row g-4 mb-4">

                    <div class="col-lg-6">
                        <div class="wb-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-users text-success me-2"></i>Top Vendors by Spend
                                    <span class="chart-hint">(Click to drill down)</span>
                                </h6>
                                <div class="wb-info-wrapper">
                                    <span class="wb-info-icon">i</span>
                                    <div class="wb-info-tooltip">Highlights the highest-spending vendors based on total billed amounts within the selected reporting period and filters.
                                    </div>
                                </div>
                            </div>
                            <div style="height:280px; position:relative; cursor:pointer;" t-on-click="() => this.openAction('vendor')">
                                <canvas t-ref="chart_vendor"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="wb-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="fw-bold text-dark m-0">
                                    <i class="fa fa-clock-o text-info me-2"></i>Vendor Payment Lead Time
                                </h6>
                                <div class="wb-info-wrapper">
                                    <span class="wb-info-icon">i</span>
                                    <div class="wb-info-tooltip">Measures the average payment period granted by vendors, based on the difference between bill dates and payment due dates.</div>
                                </div>
                            </div>

                            <div style="height:280px; position:relative; cursor:pointer;" t-on-click="() => this.openAction('lead_time')">
                                <canvas t-ref="chart_lead_time"></canvas>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
            <div class="wb-sidebar d-print-none" t-if="state.showSidebar">

                <div class="p-4 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-sliders text-primary me-2 fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Dashboard Filters</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary rounded-pill fw-bold d-flex align-items-center" t-on-click="resetFilters" title="Reset all filters">
                            <i class="fa fa-refresh me-1"></i> Reset
                        </button>
                        <button class="btn btn-sm btn-light border rounded-circle" t-on-click="toggleSidebar">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                </div>

                <div class="wb-sidebar-scroll">

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Time Period</label>
                        <select class="form-select wb-input mb-3" t-model="state.period" t-on-change="onChangePeriod">
                            <option value="7">📅 Last 7 Days</option>
                            <option value="30">📅 Last Month</option>
                            <option value="90">📅 Last 3 Months</option>
                            <option value="180">📅 Last 6 Months</option>
                            <option value="365">📅 Last Year</option>
                        </select>
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2"><i class="fa fa-calendar me-1"></i> Custom Date Range</label>
                        <input type="date" class="form-control wb-input form-control-sm mb-2" t-model="state.date_from" t-on-change="applyDateFilter"/>
                        <input type="date" class="form-control wb-input form-control-sm" t-model="state.date_to" t-on-change="applyDateFilter"/>
                    </div>

                    <hr class="text-muted opacity-25"/>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Vendor Filter</label>
                        <select class="form-select wb-input" t-model="state.filters.vendor_id" t-on-change="onApplyFilter">
                            <option value="all">🏢 All Vendors</option>
                            <t t-foreach="state.filter_options?.vendors || []" t-as="vendor" t-key="vendor.id">
                                <option t-att-value="vendor.id"><t t-esc="vendor.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Accounting Journal</label>
                        <select class="form-select wb-input" t-model="state.filters.journal_id" t-on-change="onApplyFilter">
                            <option value="all">📓 All Journals</option>
                            <t t-foreach="state.filter_options?.journals || []" t-as="journal" t-key="journal.id">
                                <option t-att-value="journal.id"><t t-esc="journal.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Payment Terms Filter </label>
                        <select class="form-select wb-input" t-model="state.filters.payment_term_id" t-on-change="onApplyFilter">
                            <option value="all">⏳ All Payment Terms</option>
                            <t t-foreach="state.filter_options?.payment_terms || []" t-as="pt" t-key="pt.id">
                                <option t-att-value="pt.id"><t t-esc="pt.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Product Category Filter</label>
                        <select class="form-select wb-input" t-model="state.filters.category_id" t-on-change="onApplyFilter">
                            <option value="all">📁 All Categories</option>
                            <t t-foreach="state.filter_options?.categories || []" t-as="cat" t-key="cat.id">
                                <option t-att-value="cat.id"><t t-esc="cat.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-2">Warehouse / Location</label>
                        <select class="form-select wb-input" t-model="state.filters.location_id" t-on-change="onApplyFilter">
                            <option value="all">📍 All Locations</option>
                            <t t-foreach="state.filter_options?.locations || []" t-as="loc" t-key="loc.id">
                                <option t-att-value="loc.id"><t t-esc="loc.display_name"/></option>
                            </t>
                        </select>
                    </div>

                    <hr class="text-muted opacity-25"/>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold text-xs text-uppercase mb-3">Advanced Filters</label>

                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_posted" t-att-checked="state.active_filters.state_posted" t-on-change="() => this.toggleFilter('state_posted')"/>
                            <label class="form-check-label text-dark fw-bold mb-0" for="f_posted">Posted Bills Only</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_draft" t-att-checked="state.active_filters.state_draft" t-on-change="() => this.toggleFilter('state_draft')"/>
                            <label class="form-check-label text-dark fw-bold mb-0" for="f_draft">Draft Bills</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_paid" t-att-checked="state.active_filters.pay_paid" t-on-change="() => this.toggleFilter('pay_paid')"/>
                            <label class="form-check-label text-success fw-bold mb-0" for="f_paid">Fully Paid</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_not_paid" t-att-checked="state.active_filters.pay_not_paid" t-on-change="() => this.toggleFilter('pay_not_paid')"/>
                            <label class="form-check-label text-dark fw-bold mb-0" for="f_not_paid">Unpaid Bills</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_overdue" t-att-checked="state.active_filters.is_overdue" t-on-change="() => this.toggleFilter('is_overdue')"/>
                            <label class="form-check-label text-danger fw-bold mb-0" for="f_overdue">Overdue Bills</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_has_po" t-att-checked="state.active_filters.has_po" t-on-change="() => this.toggleFilter('has_po')"/>
                            <label class="form-check-label text-primary fw-bold mb-0" for="f_has_po">Bills Linked to PO</label>
                        </div>
                        <div class="form-check form-switch fs-6 mb-3 p-2 bg-light rounded border d-flex align-items-center">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="f_no_po" t-att-checked="state.active_filters.no_po" t-on-change="() => this.toggleFilter('no_po')"/>
                            <label class="form-check-label text-warning fw-bold mb-0" for="f_no_po">Bills Without Purchase Orders</label>
                        </div>
                    </div>

                </div>
            </div>
            </div>
    </t>
</templates>