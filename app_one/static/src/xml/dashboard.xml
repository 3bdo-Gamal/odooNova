<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="HRdashboard" owl="1">
        <style>
            .wb-dashboard-wrapper {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                height: 100%; width: 100%; display: flex; overflow: hidden; background-color: #f4f6f9;
            }
            .wb-main-content { flex-grow: 1; overflow-y: auto; padding: 2rem; position: relative; }
            .wb-sidebar { width: 350px; flex-shrink: 0; display: flex; flex-direction: column; background: #ffffff; border-left: 1px solid #e2e8f0; box-shadow: -4px 0 15px rgba(0,0,0,0.03); z-index: 10; height: 100%; transition: margin-right 0.3s ease;}
            .wb-sidebar-scroll { flex: 1 1 auto; overflow-y: auto; min-height: 0; padding: 1.5rem; }

            .wb-glassy-header {
                background: rgba(255, 255, 255, 0.6);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.8);
                border-radius: 1.25rem;
                padding: 1rem 1.5rem;
                box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);
            }

            .wb-card { background: #fff; border-radius: 16px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: all 0.3s ease; }
            .wb-card:hover { transform: translateY(-5px); box-shadow: 0 12px 20px rgba(0,0,0,0.08); }
            .wb-card.clickable:hover { border-color: #3b82f6; cursor: pointer; }

            .wb-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
            .icon-primary { background: #eff6ff; color: #3b82f6; }
            .icon-success { background: #f0fdf4; color: #22c55e; }
            .icon-info { background: #ecfeff; color: #06b6d4; }
            .icon-warning { background: #fefce8; color: #eab308; }
            .icon-danger { background: #fef2f2; color: #ef4444; }
            .icon-dark { background: #f1f5f9; color: #334155; }
            .icon-purple { background: #faf5ff; color: #a855f7; }
            .icon-teal { background: #f0fdfa; color: #14b8a6; }
            .icon-indigo { background: #e0e7ff; color: #4f46e5; }
            .icon-rose { background: #ffe4e6; color: #e11d48; }

            .wb-input { border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: inset 0 1px 2px rgba(0,0,0,0.02); transition: all 0.2s; }
            .wb-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none; }

            .wb-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(5px); z-index: 1040; display: flex; align-items: center; justify-content: center; }
            .wb-modal-content { background: white; border-radius: 20px; width: 100%; max-width: 650px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3); animation: modalFadeIn 0.3s ease-out; }
            @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

            .wb-search-dropdown-btn { background-color: transparent; border-color: #ccc !important; width: 40px; margin: -2px -5px -2px 0; border-top-right-radius: 4px !important; border-bottom-right-radius: 4px !important; box-shadow: none; transition: background-color 0.2s ease-in-out; }
            .wb-search-dropdown-btn:hover, .wb-search-dropdown-btn[aria-expanded="true"] { background-color: #eef2f6 !important; }

            .wb-custom-switch { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1rem; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; transition: border-color 0.2s; }
            .wb-custom-switch:hover { border-color: #cbd5e1; }
            .wb-custom-switch .form-check-input { width: 2.5em; height: 1.25em; cursor: pointer; margin: 0; }

            #print_report_area { background: white; padding: 40px; color: #000; font-family: Arial, sans-serif; }
            .print-header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #059669; padding-bottom: 10px; }
            .print-row { display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding: 15px 0; }
            .print-title { font-size: 16px; font-weight: bold; color: #334155; }
            .print-value { font-size: 18px; font-weight: bold; color: #0f172a; }

            .dept-card { background: linear-gradient(135deg, #ffffff, #f8fafc); border-left: 4px solid #3b82f6; }
        </style>

        <div class="wb-dashboard-wrapper">

            <t t-if="state.showExportModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-excel-o text-success me-2"></i> Export Excel Analytics</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closeExportModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-2">Group Data By (Rows)</label>
                                <select class="form-select wb-input" t-model="state.export_group">
                                    <option value="department">Department</option>
                                    <option value="manager">Manager</option>
                                    <option value="job_position">Job Position</option>
                                    <option value="none">No Grouping</option>
                                </select>
                            </div>

                            <div class="mb-4 p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark"><i class="fa fa-sitemap text-primary me-2"></i>Detailed Excel</h6>
                                    <small class="text-muted">Includes expandable/collapsible lines under each group.</small>
                                </div>
                                <div class="form-check form-switch fs-4 m-0">
                                    <input class="form-check-input shadow-sm" type="checkbox" t-model="state.detailed_excel"/>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="fw-bold text-muted text-xs text-uppercase mb-3">Select Measures (Columns)</label>
                                <div class="row g-3">
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_emp" t-model="state.meas_emp"/><label class="form-check-label text-dark fw-bold" for="m_emp">Total Employees</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_wl" t-model="state.meas_workload"/><label class="form-check-label text-dark fw-bold" for="m_wl">Total Workload</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_task" t-model="state.meas_tasks"/><label class="form-check-label text-dark fw-bold" for="m_task">Completed Tasks</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_prod" t-model="state.meas_prod"/><label class="form-check-label text-dark fw-bold" for="m_prod">Productivity</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_att" t-model="state.meas_att"/><label class="form-check-label text-dark fw-bold" for="m_att">Attendance Rate</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_turn" t-model="state.meas_turnover"/><label class="form-check-label text-dark fw-bold" for="m_turn">Turnover Rate</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_sales" t-model="state.meas_sales"/><label class="form-check-label text-dark fw-bold" for="m_sales">Sales / Emp</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_lv" t-model="state.meas_leaves"/><label class="form-check-label text-dark fw-bold" for="m_lv">Vocations Rate</label></div></div>
                                    <div class="col-md-6"><div class="form-check form-switch fs-6 p-2 bg-light rounded border"><input class="form-check-input ms-0 me-2" type="checkbox" id="m_ab" t-model="state.meas_absence"/><label class="form-check-label text-dark fw-bold" for="m_ab">Absence Rate</label></div></div>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closeExportModal">Cancel</button>
                            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" t-on-click="downloadCustomExcel">
                                <i class="fa fa-download me-2"></i> Download Excel
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <t t-if="state.showPdfModal">
                <div class="wb-modal-overlay">
                    <div class="wb-modal-content">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light" style="border-radius: 20px 20px 0 0;">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-file-pdf-o text-danger me-2"></i> Print Report KPIs</h5>
                            <button class="btn btn-sm btn-light border rounded-circle" t-on-click="closePdfModal"><i class="fa fa-times"></i></button>
                        </div>
                        <div class="p-4">
                            <p class="text-muted mb-3">Select the KPIs you want to include in the printed report:</p>
                            <div class="list-group shadow-sm">
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_emp" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Total Employees &amp; Turnover</strong><small class="text-muted">Include total headcount and turnover rate.</small></span>
                                </label>
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_workload" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Workload &amp; Productivity</strong><small class="text-muted">Include total workload hours and task completion.</small></span>
                                </label>
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_att" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Attendance &amp; Absence</strong><small class="text-muted">Include attendance, vocations, and absence rates.</small></span>
                                </label>
                                <label class="list-group-item d-flex gap-3 py-3">
                                  <input class="form-check-input flex-shrink-0" type="checkbox" t-model="state.pdf_sales" style="font-size: 1.3em;"/>
                                  <span><strong class="d-block text-dark">Sales per Employee</strong><small class="text-muted">Include sales performance metrics.</small></span>
                                </label>
                            </div>
                        </div>
                        <div class="p-3 border-top bg-light text-end" style="border-radius: 0 0 20px 20px;">
                            <button class="btn btn-light border rounded-pill px-4 me-2 fw-bold" t-on-click="closePdfModal">Cancel</button>
                            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" t-on-click="downloadPdf"><i class="fa fa-print me-2"></i> Print PDF</button>
                        </div>
                    </div>
                </div>
            </t>

            <div id="print_report_area" style="display: none;">
                <div class="print-header">
                    <h1 style="margin: 0;">HR Analytics Report</h1>
                    <p style="color: #64748b; margin-top: 5px;">Generated on: <t t-esc="new Date().toLocaleDateString()"/></p>
                </div>
                <div t-if="state.pdf_emp" class="print-row"><span class="print-title">Total Employees</span><span class="print-value"><t t-esc="state.employee_count"/></span></div>
                <div t-if="state.pdf_emp" class="print-row"><span class="print-title">Employee Turnover</span><span class="print-value"><t t-esc="state.emp_turnover"/> %</span></div>
                <div t-if="state.pdf_workload" class="print-row"><span class="print-title">Total Workload</span><span class="print-value"><t t-esc="state.workload_hours"/> Hrs</span></div>
                <div t-if="state.pdf_workload" class="print-row"><span class="print-title">Completed Tasks</span><span class="print-value"><t t-esc="state.tasks_complete"/></span></div>
                <div t-if="state.pdf_workload" class="print-row"><span class="print-title">Productivity</span><span class="print-value"><t t-esc="state.production_kpi"/> %</span></div>
                <div t-if="state.pdf_att" class="print-row"><span class="print-title">Attendance Rate</span><span class="print-value"><t t-esc="state.attendance"/> %</span></div>
                <div t-if="state.pdf_att" class="print-row"><span class="print-title">Vacations Rate</span><span class="print-value"><t t-esc="state.average_leaves"/> %</span></div>
                <div t-if="state.pdf_att" class="print-row"><span class="print-title">Absence Rate</span><span class="print-value" style="color: #dc2626;"><t t-esc="state.absence"/> %</span></div>
                <div t-if="state.pdf_sales" class="print-row"><span class="print-title">Sales Done / Emp</span><span class="print-value"><t t-esc="state.sales_per_emp"/></span></div>
                <div style="margin-top: 40px; text-align: center; color: #94a3b8; font-size: 12px;">* Report generated automatically from Odoo HR Dashboard.</div>
            </div>

            <div class="wb-main-content">

                <div class="wb-glassy-header d-flex justify-content-between align-items-center mb-4 d-print-none gap-4">
                    <div class="flex-shrink-0">
                        <h3 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">
                            <i class="fa fa-users text-primary me-2"></i>HR Analytics
                        </h3>
                        <p class="text-muted text-sm mb-0">Track employee performance, attendance, and workload.</p>
                    </div>

                    <div class="flex-grow-1 d-flex justify-content-center d-print-none mx-4" style="max-width: 500px;">
                        <div class="shadow-sm d-flex align-items-stretch w-100" style="background: #ffffff; border-radius: 9999px; border: 1px solid #e2e8f0; min-height: 38px; padding: 0 10px;">
                            <div class="d-flex align-items-center justify-content-center" style="width: 30px;">
                                <i class="fa fa-search text-muted"></i>
                            </div>

                            <div class="d-flex flex-wrap flex-grow-1 align-items-center gap-1 py-1" style="min-height: 36px;">
                                <t t-if="state.active_favorite_name">
                                    <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                        <span class="px-2 py-1 text-white" style="background-color: #ffc107;"><i class="fa fa-star"></i></span>
                                        <span class="px-2 fw-bold text-dark"><t t-esc="state.active_favorite_name"/></span>
                                        <i class="fa fa-times px-2 cursor-pointer" style="cursor: pointer;" t-on-click="clearFavorite"></i>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="state.search_query">
                                        <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                            <span class="px-2 py-1 bg-primary text-white"><i class="fa fa-search"></i></span>
                                            <span class="px-2"><t t-esc="state.search_query"/></span>
                                            <i class="fa fa-times px-2 cursor-pointer" style="cursor: pointer;" t-on-click="clearSearchQuery"></i>
                                        </div>
                                    </t>
                                    <t t-if="state.active_filters.active_emp">
                                        <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                            <span class="px-2 py-1" style="background-color: #714B67; color: white;"><i class="fa fa-filter"></i></span>
                                            <span class="px-2">Active Employees</span>
                                            <i class="fa fa-times px-2 cursor-pointer" style="cursor: pointer;" t-on-click="() => this.toggleFilter('active_emp')"></i>
                                        </div>
                                    </t>
                                    <t t-if="state.active_filters.archived_emp">
                                        <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                            <span class="px-2 py-1" style="background-color: #714B67; color: white;"><i class="fa fa-filter"></i></span>
                                            <span class="px-2">Archived Employees</span>
                                            <i class="fa fa-times px-2 cursor-pointer" style="cursor: pointer;" t-on-click="() => this.toggleFilter('archived_emp')"></i>
                                        </div>
                                    </t>
                                    <t t-foreach="state.group_by_list" t-as="gb" t-key="gb">
                                        <div class="badge d-flex align-items-center p-0 overflow-hidden" style="background-color: #eef2f6; border: 1px solid #d3dbe3; color: #495057; border-radius: 3px;">
                                            <span class="px-2 py-1" style="background-color: #714B67; color: white;"><i class="fa fa-bars"></i></span>
                                            <span class="px-2 text-capitalize"><t t-esc="gb.replace('_', ' ')"/></span>
                                            <i class="fa fa-times px-2 cursor-pointer" style="cursor: pointer;" t-on-click="() => this.removeGroupBy(gb)"></i>
                                        </div>
                                    </t>
                                </t>

                                <input type="text" class="border-0 fw-bold flex-grow-1 px-1"
                                       t-on-keyup="onSearchKeyUp"
                                       placeholder="Search by Employee Name..."
                                       style="box-shadow: none; background: transparent; min-width: 150px; outline: none; height: 26px;"/>
                            </div>

                            <div class="dropdown d-flex align-items-stretch">
                                <button class="btn border-0 d-flex align-items-center justify-content-center wb-search-dropdown-btn bg-transparent"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside">
                                    <i class="fa fa-caret-down" style="color: #495057; font-size: 14px;"></i>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end shadow-lg mt-1 p-0" style="width: 750px; border-radius: 12px; border: 1px solid #ccc;">
                                    <div class="row g-0">
                                        <div class="col-4 border-end p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-filter me-2 text-muted"></i>Filters</h6>
                                            <a class="dropdown-item px-2 py-1 rounded d-flex align-items-center text-dark" href="#" t-on-click.prevent="() => this.toggleFilter('active_emp')">
                                                <i t-attf-class="fa fa-check me-2 {{ state.active_filters.active_emp ? 'text-dark' : 'opacity-0' }}"/> Active Employees
                                            </a>
                                            <a class="dropdown-item px-2 py-1 rounded d-flex align-items-center text-dark" href="#" t-on-click.prevent="() => this.toggleFilter('archived_emp')">
                                                <i t-attf-class="fa fa-check me-2 {{ state.active_filters.archived_emp ? 'text-dark' : 'opacity-0' }}"/> Archived Employees
                                            </a>
                                        </div>
                                        <div class="col-4 border-end p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-bars me-2 text-muted"></i>Group By</h6>
                                            <a class="dropdown-item px-2 py-1 rounded d-flex align-items-center text-dark" href="#" t-on-click.prevent="() => this.toggleGroupBy('department')">
                                                <i t-attf-class="fa fa-check me-2 {{ state.group_by_list.includes('department') ? 'text-dark' : 'opacity-0' }}"/> Department
                                            </a>
                                            <a class="dropdown-item px-2 py-1 rounded d-flex align-items-center text-dark" href="#" t-on-click.prevent="() => this.toggleGroupBy('manager')">
                                                <i t-attf-class="fa fa-check me-2 {{ state.group_by_list.includes('manager') ? 'text-dark' : 'opacity-0' }}"/> Manager
                                            </a>
                                            <a class="dropdown-item px-2 py-1 rounded d-flex align-items-center text-dark" href="#" t-on-click.prevent="() => this.toggleGroupBy('job_position')">
                                                <i t-attf-class="fa fa-check me-2 {{ state.group_by_list.includes('job_position') ? 'text-dark' : 'opacity-0' }}"/> Job Position
                                            </a>
                                        </div>
                                        <div class="col-4 p-3">
                                            <h6 class="dropdown-header text-dark fw-bold fs-6 mb-2 px-1"><i class="fa fa-star me-2 text-muted"></i>Favorites</h6>
                                            <div class="px-1 mb-3">
                                                <button class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center py-1 border-0 shadow-none bg-light" t-on-click.prevent="toggleSaveMenu" style="font-size: 14px;">
                                                    Save current search <i t-attf-class="fa {{ state.show_save_menu ? 'fa-caret-down' : 'fa-caret-left' }}"></i>
                                                </button>
                                                <t t-if="state.show_save_menu">
                                                    <div class="mt-2" style="font-size: 13px;">
                                                        <input type="text" class="form-control form-control-sm border-0 border-bottom rounded-0 shadow-none mb-2 px-1" t-model="state.favorite_name" style="border-color: #666 !important;" t-on-click.stop=""/>
                                                        <div class="form-check mb-1">
                                                            <input class="form-check-input" type="checkbox" id="fav_default" t-model="state.is_default_fav" t-on-change="onDefaultCheckboxChange" t-on-click.stop=""/>
                                                            <label class="form-check-label text-muted" for="fav_default">Default filter</label>
                                                        </div>
                                                        <div class="form-check mb-3">
                                                            <input class="form-check-input" type="checkbox" id="fav_shared" t-model="state.is_shared_fav" t-on-change="onSharedCheckboxChange" t-on-click.stop=""/>
                                                            <label class="form-check-label text-muted" for="fav_shared">Shared</label>
                                                        </div>
                                                        <button class="btn btn-sm w-100 text-white fw-bold" style="background-color: #714B67;" t-on-click="saveFavoriteUI">Save</button>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="dropdown-divider"></div>
                                            <t t-foreach="state.saved_favorites" t-as="fav" t-key="fav.id">
                                                <div class="dropdown-item px-2 py-1 rounded d-flex justify-content-between align-items-center" style="cursor:pointer;">
                                                    <span t-on-click="() => this.loadFavorite(fav)" class="flex-grow-1"><i class="fa fa-star text-warning me-2"></i> <t t-esc="fav.name"/></span>
                                                    <i class="fa fa-trash text-muted ms-2" t-on-click.stop="() => this.deleteFavorite(fav.id)"></i>
