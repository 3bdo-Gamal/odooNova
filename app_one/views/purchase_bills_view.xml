<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_purchase_bills_dashboard_unique" model="ir.actions.client">
            <field name="name">Bills Analysis</field>
            <field name="tag">purchase_bills_dashboard_tag</field>
        </record>

        <menuitem id="menu_purchase_dashboards_container"
                  name="Purchase Dashboards"
                  parent="wb_app_one_root_menu"
                  sequence="4"/>

        <menuitem id="menu_purchase_bills_dashboard_unique"
                  name="Bills Dashboard"
                  parent="menu_purchase_dashboards_container"
                  action="action_purchase_bills_dashboard_unique"
                  sequence="2"/>

        <record id="view_in_invoice_tree_inherit_analytics" model="ir.ui.view">
            <field name="name">account.out.invoice.tree.inherit.analytics</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                    <field name="nova_payment_lead_time" optional="show"/>
                    <field name="nova_overdue_days" optional="show" decoration-danger="nova_overdue_days &gt; 0"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree_inherit_variance" model="ir.ui.view">
            <field name="name">account.move.line.tree.inherit.variance</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="nova_purchase_price_unit" optional="show" widget="monetary" string="PO Price"/>
                    <field name="nova_price_variance" optional="show" decoration-danger="nova_price_variance &gt; 0.01" decoration-success="nova_price_variance &lt; -0.01" widget="monetary"/>
                    <field name="nova_qty_variance" optional="show" decoration-danger="nova_qty_variance &gt; 0.01" decoration-success="nova_qty_variance &lt; -0.01"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>